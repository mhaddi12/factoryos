# Application
APP_URL=http://localhost:3000

# Session signing secret. Generate one with: npx node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# PostgreSQL
# Docker Compose publishes Postgres on host port 5433 so it does not clash
# with a local PostgreSQL install on 5432.
DATABASE_URL=postgresql://factoryos:factoryos@127.0.0.1:5433/factoryos?schema=public

# Reserved for later. Not used in V1.
# REDIS_URL=redis://127.0.0.1:6379
# S3_ENDPOINT=
# S3_REGION=auto
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
